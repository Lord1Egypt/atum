//@version=6
strategy("Risk-Based Strategy Template", shorttitle="Risk Template", overlay=true,
         initial_capital       = 10000,
         default_qty_type      = strategy.percent_of_equity,
         default_qty_value     = 100,
         commission_type       = strategy.commission.percent,
         commission_value      = 0.05,
         slippage              = 2)

// The entry signal here is deliberately trivial. What this template actually
// demonstrates is the part that decides whether a strategy survives: position
// sizing derived from risk, an ATR stop, targets expressed in R, and costs
// modelled from the first backtest rather than added later.

// ---------- Risk ----------
riskPct   = input.float(1.0, "Risk per trade (% of equity)", minval=0.1, maxval=10, step=0.1, group="Risk")
atrLen    = input.int(14,    "ATR length",                   minval=1,             group="Risk")
slMult    = input.float(2.0, "Stop loss (ATR multiple)",     minval=0.1, step=0.1, group="Risk")
rMultiple = input.float(2.0, "Take profit (R multiple)",     minval=0.1, step=0.1, group="Risk")

// ---------- Signal ----------
lenFast = input.int(21, "Fast EMA", minval=1, group="Signal")
lenSlow = input.int(50, "Slow EMA", minval=1, group="Signal")

// ---------- Filters ----------
useSession = input.bool(false,        "Restrict to a session",        group="Filters")
sess       = input.session("0930-1600", "Session",                    group="Filters")
useTrend   = input.bool(true,         "Trade only with the 200 EMA",  group="Filters")

// ---------- Calculations ----------
atrValue = ta.atr(atrLen)
emaFast  = ta.ema(close, lenFast)
emaSlow  = ta.ema(close, lenSlow)
ema200   = ta.ema(close, 200)

inSession = not useSession or not na(time(timeframe.period, sess))
trendUp   = not useTrend   or close > ema200
trendDown = not useTrend   or close < ema200

longSignal  = ta.crossover(emaFast,  emaSlow) and inSession and trendUp
shortSignal = ta.crossunder(emaFast, emaSlow) and inSession and trendDown

// ---------- Position sizing ----------
// Size is solved backwards from the stop: if the stop is hit, the loss equals
// riskPct of current equity, whatever the instrument or the volatility. A fixed
// contract count cannot do this - it risks a different amount on every trade.
stopDist = atrValue * slMult
riskCash = strategy.equity * riskPct / 100
qty      = stopDist > 0 ? riskCash / stopDist : na

flat = strategy.position_size == 0

if longSignal and flat and not na(qty)
    strategy.entry("Long", strategy.long, qty = qty)
    strategy.exit("Long exit", from_entry = "Long",
                  stop  = close - stopDist,
                  limit = close + stopDist * rMultiple)

if shortSignal and flat and not na(qty)
    strategy.entry("Short", strategy.short, qty = qty)
    strategy.exit("Short exit", from_entry = "Short",
                  stop  = close + stopDist,
                  limit = close - stopDist * rMultiple)

// ---------- Results table ----------
var table stats = table.new(position.top_right, 2, 5, border_width = 1)

if barstate.islast
    closed  = strategy.closedtrades
    winRate = closed > 0 ? strategy.wintrades / closed * 100 : 0.0
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na

    table.cell(stats, 0, 0, "Closed trades", text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 0, str.tostring(closed),                     text_size = size.small)
    table.cell(stats, 0, 1, "Win rate",      text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 1, str.tostring(winRate, "#.#") + " %",      text_size = size.small)
    table.cell(stats, 0, 2, "Profit factor", text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 2, na(pf) ? "n/a" : str.tostring(pf, "#.##"), text_size = size.small)
    table.cell(stats, 0, 3, "Net profit",    text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 3, str.tostring(strategy.netprofit, "#.##"), text_size = size.small)
    table.cell(stats, 0, 4, "Max drawdown",  text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 4, str.tostring(strategy.max_drawdown, "#.##"), text_size = size.small)

// ---------- Visuals ----------
plot(emaFast, "Fast EMA", color = color.new(color.teal,   0))
plot(emaSlow, "Slow EMA", color = color.new(color.orange, 0))
plot(useTrend ? ema200 : na, "200 EMA", color = color.new(color.gray, 40))
