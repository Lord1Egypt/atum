//@version=6
indicator("Risk per trade (library demo)", overlay = true)
// Replace YourUsername with the TradingView username that published RiskTools, and 1 with its current version
import YourUsername/RiskTools/1 as rt

riskCash = input.float(100, "Cash to risk per trade (symbol currency)", minval = 1)
atrMult  = input.float(2, "Stop distance (x ATR)", minval = 0.5, step = 0.5)
qtyStep  = input.float(1, "Quantity step", minval = 0)

float stopDist = atrMult * ta.atr(14)
float qty = rt.roundDown(rt.qtyForRisk(riskCash, stopDist), qtyStep)

pl = ta.pivotlow(low, 5, 5)
var rt.Level lastLow = rt.Level.new(na, na)
if not na(pl)
    lastLow := rt.Level.new(pl, bar_index - 5)

plot(close - stopDist, "Long stop", color.red)
plot(qty, "Quantity for the risk", display = display.data_window)
plot(lastLow.distancePct(close), "% above the last swing low", display = display.data_window)
