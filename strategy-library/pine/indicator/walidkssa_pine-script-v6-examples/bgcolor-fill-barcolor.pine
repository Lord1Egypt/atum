// Pine Script bgcolor, fill and barcolor examples (v6)
// Explained (key lines, pitfalls, variations, FAQ): https://edgoro.com/pine-script-examples/bgcolor-fill-barcolor
// MIT License, Copyright (c) 2026 Edgoro. For education: test on a demo account before any live use.

//@version=6
indicator("Background, fill and bar colors", overlay = true)

fastLen = input.int(20, "Fast EMA", minval = 1)
slowLen = input.int(50, "Slow EMA", minval = 2)
rsiLen  = input.int(14, "RSI length", minval = 2)
volMult = input.float(1.5, "High volume (x 20-bar average)", minval = 1, step = 0.1)

fast   = ta.ema(close, fastLen)
slow   = ta.ema(close, slowLen)
rsi    = ta.rsi(close, rsiLen)
volAvg = ta.sma(volume, 20)

bool bull = fast > slow

// fill() works on plot IDs: keep what plot() returns
pFast = plot(fast, "Fast EMA", bull ? color.teal : color.red)
pSlow = plot(slow, "Slow EMA", color.gray)
fill(pFast, pSlow, bull ? color.new(color.teal, 80) : color.new(color.red, 80), "Trend cloud")

// Background: transparent at 70, stronger as RSI rises to 90 (and the mirror below 30)
color hotColor  = color.from_gradient(rsi, 70, 90, color.new(color.red, 100), color.new(color.red, 70))
color coldColor = color.from_gradient(rsi, 10, 30, color.new(color.green, 70), color.new(color.green, 100))
bgcolor(rsi > 70 ? hotColor : rsi < 30 ? coldColor : na, title = "RSI extremes")

// Candles: strong up or down bars on high volume, on the right side of the slow EMA
bool bigVolume  = volume > volMult * volAvg
bool strongUp   = bigVolume and close > open and close > slow
bool strongDown = bigVolume and close < open and close < slow
barcolor(strongUp ? color.lime : strongDown ? color.fuchsia : na, title = "High-volume bars")
