// Docs (PL): https://github.com/piecioshka/tradingview-pine-scripts/blob/main/indicators/seasonality/daily-seasonality/daily-seasonality.pl.md

//@version=6
indicator('Daily Seasonality', overlay = true)

// Colors the chart background differently depending on the day of the week.
// Works best on intraday and daily charts - the recurring weekly pattern
// becomes visible (e.g. low volatility on Friday vs movement on Monday).
// Day = the trading day the bar belongs to (time_tradingday), not the calendar
// day of the bar's open time. Forex, futures and CFD daily bars open the evening
// before (e.g. Monday's bar opens Sunday 17:00 New York), so dayofweek(time)
// labeled them with the previous day and Monday was painted as Sunday.
// Default colors avoid red and green, so the background never reads as a
// bullish/bearish signal. Every day's color can be changed in the settings.

transp         = input.int(title='Transparency (0-100)', defval=80, minval=0, maxval=100, step=5)
showLegend     = input.bool(title='Show legend', defval=true)
legendPosition = input.string(title='Legend position', defval='Top right', options=['Top left', 'Top right', 'Bottom left', 'Bottom right'])

// Enable/disable individual days of the week and pick their colors.
// Useful e.g. for markets without a weekend - Saturday and Sunday can be turned off.
gDays = 'Days of the week'
useMon = input.bool(title='Monday',    defval=true, group=gDays, inline='mon')
colMon = input.color(title='', defval=color.rgb(66, 133, 244),  group=gDays, inline='mon')   // blue
useTue = input.bool(title='Tuesday',   defval=true, group=gDays, inline='tue')
colTue = input.color(title='', defval=color.rgb(156, 39, 176),  group=gDays, inline='tue')   // purple
useWed = input.bool(title='Wednesday', defval=true, group=gDays, inline='wed')
colWed = input.color(title='', defval=color.rgb(255, 152, 0),   group=gDays, inline='wed')   // orange
useThu = input.bool(title='Thursday',  defval=true, group=gDays, inline='thu')
colThu = input.color(title='', defval=color.rgb(0, 188, 212),   group=gDays, inline='thu')   // cyan
useFri = input.bool(title='Friday',    defval=true, group=gDays, inline='fri')
colFri = input.color(title='', defval=color.rgb(255, 235, 59),  group=gDays, inline='fri')   // yellow
useSat = input.bool(title='Saturday',  defval=true, group=gDays, inline='sat')
colSat = input.color(title='', defval=color.rgb(158, 158, 158), group=gDays, inline='sat')   // gray
useSun = input.bool(title='Sunday',    defval=true, group=gDays, inline='sun')
colSun = input.color(title='', defval=color.rgb(141, 110, 99),  group=gDays, inline='sun')   // brown

// time_tradingday is midnight UTC of the trading day, so read it in UTC
d = dayofweek(time_tradingday, 'UTC')

bgCol = switch d
    dayofweek.monday    => useMon ? color.new(colMon, transp) : na
    dayofweek.tuesday   => useTue ? color.new(colTue, transp) : na
    dayofweek.wednesday => useWed ? color.new(colWed, transp) : na
    dayofweek.thursday  => useThu ? color.new(colThu, transp) : na
    dayofweek.friday    => useFri ? color.new(colFri, transp) : na
    dayofweek.saturday  => useSat ? color.new(colSat, transp) : na
    dayofweek.sunday    => useSun ? color.new(colSun, transp) : na
    => na

bgcolor(bgCol)

// Legend - a table showing which days have which color
if showLegend and barstate.islast
    pos = switch legendPosition
        'Top left'     => position.top_left
        'Top right'    => position.top_right
        'Bottom left'  => position.bottom_left
        'Bottom right' => position.bottom_right
        =>                position.top_right

    days    = array.from('Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday')
    colors  = array.from(colMon, colTue, colWed, colThu, colFri, colSat, colSun)
    enabled = array.from(useMon, useTue, useWed, useThu, useFri, useSat, useSun)

    activeCount = 0
    for i = 0 to 6
        if array.get(enabled, i)
            activeCount += 1

    if activeCount > 0
        legend = table.new(position = pos, columns = 2, rows = activeCount, border_width = 1)
        row = 0
        for i = 0 to 6
            if array.get(enabled, i)
                table.cell(legend, 0, row, '    ', bgcolor = array.get(colors, i))
                table.cell(legend, 1, row, array.get(days, i), text_color = color.white, bgcolor = color.new(color.black, 30))
                row += 1
