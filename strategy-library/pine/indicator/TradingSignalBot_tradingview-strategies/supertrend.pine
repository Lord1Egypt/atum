//@version=6
// This source code is subject to the terms of the MIT License (LICENSE in the source repository).
// © TradingSignalBot
//
// Supertrend. The line trails price at a multiple of the ATR from the middle of each candle (ATR 10,
// multiplier 3 by default), under price in an uptrend and over it in a downtrend, and jumps to the
// other side when a candle closes through it. The candle that flips it up is a buy, the one that
// flips it down a sell. The stop is the line's value on that candle; the targets are multiples of
// the stop distance. One signal a flip. Built on 1-hour candles by default.
indicator("Supertrend Flip - Entry, Stop at the Line and Targets", shorttitle = "Supertrend Flip", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

const string ID = "supertrend"
const string NAME = "Supertrend"
const float TP1_R = 1.0
const float TP2_R = 2.0
const float TP3_R = 3.0

// ---- TSBStyle:begin ----
// Inline copy of library/TSBStyle.pine (scripts/sync-style.mjs writes it: edit the library, not this).
// @function The ink colour: panel backgrounds.
// @returns color
colInk() => #0B0B0D

// @function The grey colour: secondary text and frames.
// @returns color
colGrey() => #8A949E

// @function The entry colour.
// @returns color
colWhite() => #FFFFFF

// @function The stop colour, and sells.
// @returns color
colRed() => #E5484D

// @function The target colour, and buys.
// @returns color
colGreen() => #16A34A

// @function The colour of a strategy's levels (the opening range, a swing, the previous day's high or low).
// @returns color
colGold() => #E8B84A

// @function The colour of a session range (the Asian range) and a second indicator line.
// @returns color
colBlue() => #5B8DEF

// @function The colour of indicator marks (a trend EMA, a divergence line).
// @returns color
colViolet() => #B18CFF

// @type The drawings of one signal, deleted together once it is no longer among the newest kept.
// @field lines Its lines.
// @field labels Its labels.
// @field boxes Its boxes.
type Drawn
    array<line> lines
    array<label> labels
    array<box> boxes

// @function An empty set of drawings.
// @returns Drawn
newDrawn() =>
    Drawn.new(array.new<line>(), array.new<label>(), array.new<box>())

// @function The pip size of a symbol, by the house convention: gold one dollar, JPY pairs 0.01, other currency pairs 0.0001, anything else ten ticks.
// @param ticker The symbol's ticker (syminfo.ticker).
// @param symType The symbol's type (syminfo.type).
// @param mintick The symbol's tick (syminfo.mintick).
// @param override A pip size to use instead; 0 for automatic.
// @returns float
pipSize(string ticker, string symType, float mintick, float override) =>
    string fiat = "USD EUR GBP JPY CHF AUD NZD CAD NOK SEK DKK SGD HKD MXN ZAR PLN TRY CNH"
    bool fx = symType == "forex" or (str.length(ticker) == 6 and str.contains(fiat, str.substring(ticker, 0, 3)) and str.contains(fiat, str.substring(ticker, 3, 6)))
    float p = mintick * 10.0
    if override > 0
        p := override
    else if str.contains(ticker, "XAU")
        p := 1.0
    else if fx
        p := str.endswith(ticker, "JPY") ? 0.01 : 0.0001
    p

// @function The distance between two prices in whole pips.
// @param a A price.
// @param b Another price.
// @param pipSz The pip size (pipSize()).
// @returns int
pipsBetween(float a, float b, float pipSz) =>
    math.round(math.abs(a - b) / pipSz)

// @function A price as the chart shows it.
// @param v The price.
// @returns string
priceText(float v) =>
    str.tostring(v, format.mintick)

// @function The target multiples as a sentence: "1, 2, 3"; a target of 0 is left out.
// @param r1 TP1 in multiples of the stop distance.
// @param r2 TP2.
// @param r3 TP3, or 0.
// @returns string
rsText(float r1, float r2, float r3) =>
    string s = str.tostring(r1) + ", " + str.tostring(r2)
    if r3 > 0
        s += ", " + str.tostring(r3)
    s

// @function A target at a multiple of the stop distance, or na when the multiple is 0.
// @param isBuy True for a buy.
// @param entry The entry price.
// @param stop The stop price.
// @param r The multiple.
// @returns float
targetAt(bool isBuy, float entry, float stop, float r) =>
    float risk = math.abs(entry - stop)
    r > 0 ? (isBuy ? entry + r * risk : entry - r * risk) : na

// @function A filled tag at the right end of a level, with its text.
// @param x The bar index of the tag.
// @param y Its price.
// @param txt Its text.
// @param bg Its fill.
// @param fg Its text colour.
// @param lblSize A label size ("tiny", "small", "normal", "large").
// @returns label
levelTag(int x, float y, string txt, color bg, color fg, string lblSize) =>
    label.new(x = x, y = y, text = txt, xloc = xloc.bar_index, yloc = yloc.price, color = bg, textcolor = fg, style = label.style_label_left, size = lblSize)

// @function The entry, the stop and the targets, drawn from the signal candle, and the signal marked on it.
// @param isBuy True for a buy.
// @param entry The entry price (the signal candle's close).
// @param stop The stop price.
// @param tp1 TP1.
// @param tp2 TP2, or na.
// @param tp3 TP3, or na.
// @param x The signal candle's bar index.
// @param length How many candles the levels run to the right.
// @param name The strategy's name, for the mark on the candle.
// @param pipSz The pip size (pipSize()).
// @param lblSize A label size.
// @param anchor Where the mark sits: the candle's low for a buy, its high for a sell.
// @returns Drawn
drawSignal(bool isBuy, float entry, float stop, float tp1, float tp2, float tp3, int x, int length, string name, float pipSz, string lblSize, float anchor) =>
    Drawn d = newDrawn()
    int x2 = x + length
    string word = isBuy ? "BUY" : "SELL"
    d.lines.push(line.new(x1 = x, y1 = entry, x2 = x2, y2 = entry, xloc = xloc.bar_index, color = colWhite(), width = 2, style = line.style_solid))
    d.lines.push(line.new(x1 = x, y1 = stop, x2 = x2, y2 = stop, xloc = xloc.bar_index, color = colRed(), width = 1, style = line.style_dashed))
    d.labels.push(levelTag(x2, entry, "ENTRY · " + word + " " + priceText(entry), colWhite(), colInk(), lblSize))
    d.labels.push(levelTag(x2, stop, "STOP LOSS · " + str.tostring(pipsBetween(entry, stop, pipSz)) + " PIPS · " + priceText(stop), colRed(), colWhite(), lblSize))
    array<float> tps = array.from(tp1, tp2, tp3)
    for [k, tp] in tps
        if not na(tp)
            d.lines.push(line.new(x1 = x, y1 = tp, x2 = x2, y2 = tp, xloc = xloc.bar_index, color = colGreen(), width = 1, style = line.style_dashed))
            d.labels.push(levelTag(x2, tp, "TP" + str.tostring(k + 1) + " · +" + str.tostring(pipsBetween(entry, tp, pipSz)) + " PIPS · " + priceText(tp), colGreen(), colWhite(), lblSize))
    d.labels.push(label.new(x = x, y = anchor, text = word + " · " + name, xloc = xloc.bar_index, yloc = yloc.price, color = isBuy ? colGreen() : colRed(), textcolor = colWhite(), style = isBuy ? label.style_label_up : label.style_label_down, size = lblSize))
    d

// @function A shaded range (the opening range, the Asian range, a sweep) with its name in the corner.
// @param xLeft The first bar index.
// @param xRight The last bar index.
// @param top The range's high.
// @param bottom The range's low.
// @param col Its colour.
// @param txt Its name.
// @param lblSize A label size.
// @returns box
rangeBox(int xLeft, int xRight, float top, float bottom, color col, string txt, string lblSize) =>
    box.new(left = xLeft, top = top, right = xRight, bottom = bottom, border_color = col, border_width = 1, border_style = line.style_solid, xloc = xloc.bar_index, bgcolor = color.new(col, 85), text = txt, text_size = lblSize, text_color = col, text_halign = text.align_left, text_valign = text.align_top)

// @function A strategy's level (a swing, the previous day's high or low): a dotted line with its name at the left end.
// @param x1 The bar index it starts at.
// @param x2 The bar index it ends at.
// @param y Its price.
// @param col Its colour.
// @param txt Its name.
// @param below True to write the name under the line.
// @param lblSize A label size.
// @returns [line, label]
levelLine(int x1, int x2, float y, color col, string txt, bool below, string lblSize) =>
    line ln = line.new(x1 = x1, y1 = y, x2 = x2, y2 = y, xloc = xloc.bar_index, color = col, width = 1, style = line.style_dotted)
    label lb = label.new(x = x1, y = y, text = txt, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(col, 100), textcolor = col, style = below ? label.style_label_up : label.style_label_down, size = lblSize)
    [ln, lb]

// @function A small mark on a candle (the break, the sweep, an RSI value).
// @param x The bar index.
// @param y The price.
// @param txt Its text.
// @param col Its colour.
// @param above True to put it over the price, false under it.
// @param tip The tooltip.
// @param lblSize A label size.
// @returns label
markLabel(int x, float y, string txt, color col, bool above, string tip, string lblSize) =>
    label.new(x = x, y = y, text = txt, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(col, 100), textcolor = col, style = above ? label.style_label_down : label.style_label_up, size = lblSize, tooltip = tip)

// @function Deletes a signal's drawings.
// @param d The drawings.
// @returns bool
deleteDrawn(Drawn d) =>
    for ln in d.lines
        line.delete(ln)
    for lb in d.labels
        label.delete(lb)
    for bx in d.boxes
        box.delete(bx)
    true

// @function Keeps a signal's drawings, and deletes the oldest beyond the newest maxKept.
// @param list The drawings kept so far.
// @param d The new signal's drawings.
// @param maxKept How many signals to keep on the chart.
// @returns int
keepDrawn(array<Drawn> list, Drawn d, int maxKept) =>
    list.push(d)
    while list.size() > math.max(maxKept, 1)
        deleteDrawn(list.shift())
    list.size()

// @function The signal as the bot's message: side, symbol and strategy; entry, stop and targets in pips; the strategy's line; the disclaimer.
// @param isBuy True for a buy.
// @param symbol The symbol.
// @param name The strategy's name.
// @param entry The entry.
// @param stop The stop.
// @param tp1 TP1.
// @param tp2 TP2, or na.
// @param tp3 TP3, or na.
// @param pipSz The pip size.
// @param why The strategy's sentence on what happened and where the stop and targets go.
// @returns string
signalText(bool isBuy, string symbol, string name, float entry, float stop, float tp1, float tp2, float tp3, float pipSz, string why) =>
    string s = (isBuy ? "🟢 BUY " : "🔴 SELL ") + symbol + " · " + name + "\n\n"
    s += "Entry: " + priceText(entry) + " (market)\n"
    s += "Stop: " + priceText(stop) + " (" + str.tostring(pipsBetween(entry, stop, pipSz)) + " pips)\n"
    array<float> tps = array.from(tp1, tp2, tp3)
    for [k, tp] in tps
        if not na(tp)
            s += "TP" + str.tostring(k + 1) + ": " + priceText(tp) + " (+" + str.tostring(pipsBetween(entry, tp, pipSz)) + " pips)\n"
    s += "\n" + why + "\n\nNot financial advice. Trade at your own risk."
    s

// @function A string made safe to put between quotes in JSON.
// @param s The string.
// @returns string
jsonText(string s) =>
    str.replace_all(str.replace_all(str.replace_all(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")

// @function The signal as JSON for a webhook (the format docs/alerts.md describes).
// @param id The strategy's id ("london-breakout").
// @param isBuy True for a buy.
// @param symbol The symbol (syminfo.ticker).
// @param exchange The exchange (syminfo.prefix).
// @param tf The chart's timeframe (timeframe.period).
// @param entry The entry.
// @param stop The stop.
// @param tp1 TP1.
// @param tp2 TP2, or na.
// @param tp3 TP3, or na.
// @param barTime The signal candle's close time, in milliseconds (time_close).
// @param msg The message (signalText()).
// @param secretKey A shared secret for the webhook, or "".
// @returns string
alertJson(string id, bool isBuy, string symbol, string exchange, string tf, float entry, float stop, float tp1, float tp2, float tp3, int barTime, string msg, string secretKey) =>
    string tps = priceText(tp1)
    if not na(tp2)
        tps += "," + priceText(tp2)
    if not na(tp3)
        tps += "," + priceText(tp3)
    string j = "{\"source\":\"tv-strategies\",\"strategy\":\"" + id + "\",\"symbol\":\"" + jsonText(symbol) + "\",\"exchange\":\"" + jsonText(exchange) + "\",\"timeframe\":\"" + tf + "\""
    j += ",\"side\":\"" + (isBuy ? "buy" : "sell") + "\",\"entry\":" + priceText(entry) + ",\"stop\":" + priceText(stop) + ",\"targets\":[" + tps + "]"
    j += ",\"time\":" + str.tostring(barTime) + ",\"text\":\"" + jsonText(msg) + "\""
    if secretKey != ""
        j += ",\"secret\":\"" + jsonText(secretKey) + "\""
    j + "}"

// @function Fills the latest-signal panel: the strategy, the side and symbol, and the levels.
// @param t A table of one column and three rows.
// @param isBuy True for a buy.
// @param name The strategy's name.
// @param symbol The symbol.
// @param detail The levels in one line.
// @returns bool
heroPanel(table t, bool isBuy, string name, string symbol, string detail) =>
    table.cell(t, 0, 0, "New signal · " + name, text_color = colGrey(), text_halign = text.align_right, text_size = size.small)
    table.cell(t, 0, 1, (isBuy ? "▲ BUY  " : "▼ SELL  ") + symbol, text_color = isBuy ? colGreen() : colRed(), text_halign = text.align_right, text_size = size.large)
    table.cell(t, 0, 2, detail, text_color = colWhite(), text_halign = text.align_right, text_size = size.small)
    true

// @function Writes a notice (a timeframe the strategy cannot run on) in a one-cell table.
// @param t A table of one cell.
// @param msg The notice.
// @returns bool
notice(table t, string msg) =>
    table.cell(t, 0, 0, msg, text_color = colGold(), text_halign = text.align_left, text_size = size.small)
    true
// ---- TSBStyle:end ----

const string GRP_S = "Strategy"
int period = input.int(10, "ATR length", minval = 1, maxval = 200, group = GRP_S, tooltip = "7, 10 and 14 are common.")
float mult = input.float(3.0, "Multiplier", minval = 0.1, step = 0.1, group = GRP_S, tooltip = "Higher is slower to flip and has a wider stop.")

// ---- common:begin ----
// Shared by every indicator in the pack: src/common.pine, copied in by scripts/sync-style.mjs.
// It expects ID, NAME, TP1_R, TP2_R and TP3_R to be declared above it.
const string GRP_T = "Entry, stop and targets"
const string GRP_D = "Drawing"
const string GRP_A = "Alerts"
float tp1R = input.float(TP1_R, "TP1, times the stop distance", minval = 0.1, step = 0.1, group = GRP_T)
float tp2R = input.float(TP2_R, "TP2, times the stop distance", minval = 0.1, step = 0.1, group = GRP_T)
float tp3R = input.float(TP3_R, "TP3, times the stop distance (0: no TP3)", minval = 0.0, step = 0.1, group = GRP_T)
int keepN = input.int(10, "Signals kept on the chart", minval = 1, maxval = 40, group = GRP_D)
int extendN = input.int(20, "Levels run for (candles)", minval = 3, maxval = 300, group = GRP_D)
string lblSize = input.string("small", "Label size", options = ["tiny", "small", "normal", "large"], group = GRP_D)
bool showHero = input.bool(true, "Latest signal panel", group = GRP_D)
float pipIn = input.float(0.0, "Pip size (0: automatic)", minval = 0.0, step = 0.0001, group = GRP_D, tooltip = "Automatic: gold 1.00, JPY pairs 0.01, other currency pairs 0.0001, anything else ten ticks.")
bool jsonAlerts = input.bool(true, "Send each signal as JSON to alert() calls", group = GRP_A, tooltip = "Create an alert on this indicator with the condition \"Any alert() function call\" to receive it.")
string secret = input.string("", "Webhook secret (optional)", group = GRP_A, tooltip = "Added to the JSON as \"secret\", for a webhook receiver that checks it. Leave empty if yours takes the secret in its address.")

float pip = pipSize(syminfo.ticker, syminfo.type, syminfo.mintick, pipIn)
bool closed = barstate.isconfirmed
bool afterGap = bar_index > 0 and time - time[1] > 86400000
var array<Drawn> drawn = array.new<Drawn>()
var table hero = table.new(position.top_right, 1, 3, bgcolor = color.new(colInk(), 10), frame_color = colGrey(), frame_width = 1)
var table note = table.new(position.bottom_right, 1, 1, bgcolor = color.new(colInk(), 10))

// What the bar signalled, for the alert conditions and the Data Window. Set where a signal fires.
bool buySig = false
bool sellSig = false
float sigEntry = na
float sigStop = na
float sigTp1 = na
float sigTp2 = na
float sigTp3 = na

// One signal at this candle's close: drawn, kept, shown in the panel and sent as JSON.
// `why` is the strategy's line for the message. Returns the drawings (for the strategy's own
// marks) and the three targets.
emit(bool isBuy, float entry, float stopPx, string why) =>
    float t1 = targetAt(isBuy, entry, stopPx, tp1R)
    float t2 = targetAt(isBuy, entry, stopPx, tp2R)
    float t3 = targetAt(isBuy, entry, stopPx, tp3R)
    Drawn d = drawSignal(isBuy, entry, stopPx, t1, t2, t3, bar_index, extendN, NAME, pip, lblSize, isBuy ? low : high)
    keepDrawn(drawn, d, keepN)
    if showHero
        heroPanel(hero, isBuy, NAME, syminfo.ticker, "Entry " + priceText(entry) + " · stop " + priceText(stopPx) + " (" + str.tostring(pipsBetween(entry, stopPx, pip)) + " pips) · TP1 " + priceText(t1))
    if jsonAlerts
        alert(alertJson(ID, isBuy, syminfo.ticker, syminfo.prefix, timeframe.period, entry, stopPx, t1, t2, t3, time_close, signalText(isBuy, syminfo.ticker, NAME, entry, stopPx, t1, t2, t3, pip, why), secret), alert.freq_once_per_bar_close)
    [d, t1, t2, t3]
// ---- common:end ----

bool tfOk = true
string tfNote = ""
float atrV = ta.atr(period)

// The line, worked out as the platforms' default Supertrend: bands at hl2 plus and minus
// mult x ATR, each only moving in the trend's direction until price closes through it.
var float upper = na
var float lower = na
var int trend = 1
var int dir = 0
var float stLine = na
int prevDir = dir
if not na(atrV)
    float bu = hl2 + mult * atrV
    float bl = hl2 - mult * atrV
    float pc = close[1]
    float nu = na(upper) or bu < upper or pc > upper ? bu : upper
    float nl = na(lower) or bl > lower or pc < lower ? bl : lower
    if not na(upper)
        trend := trend == 1 ? (close < nl ? -1 : 1) : (close > nu ? 1 : -1)
    upper := nu
    lower := nl
    dir := trend
    stLine := trend == 1 ? lower : upper

if closed and not afterGap and prevDir != 0 and dir != 0 and dir != prevDir
    bool up = dir == 1
    float stopPx = stLine
    if up ? stopPx < close : stopPx > close
        string why = "Supertrend flipped " + (up ? "up" : "down") + " (ATR " + str.tostring(period) + ", ×" + str.tostring(mult) + "). Stop at the Supertrend line; targets at " + rsText(tp1R, tp2R, tp3R) + " times the stop."
        [d, t1, t2, t3] = emit(up, close, stopPx, why)
        d.labels.push(markLabel(bar_index, stopPx, "FLIP · SUPERTREND " + str.tostring(period) + " × " + str.tostring(mult), up ? colGreen() : colRed(), not up, "The line moved to the other side of price on this candle's close.", lblSize))
        buySig := up
        sellSig := not up
        sigEntry := close
        sigStop := stopPx
        sigTp1 := t1
        sigTp2 := t2
        sigTp3 := t3

plot(dir == 1 ? stLine : na, "Supertrend (up)", color = color.new(colGreen(), 30), linewidth = 2, style = plot.style_linebr)
plot(dir == -1 ? stLine : na, "Supertrend (down)", color = color.new(colRed(), 30), linewidth = 2, style = plot.style_linebr)

// ---- outputs:begin ----
// Shared by every indicator in the pack: src/outputs.pine, copied in by scripts/sync-style.mjs.
// It expects tfOk and tfNote to be declared above it.
plot(sigEntry, "Entry", color = colWhite(), display = display.data_window)
plot(sigStop, "Stop", color = colRed(), display = display.data_window)
plot(sigTp1, "TP1", color = colGreen(), display = display.data_window)
plot(sigTp2, "TP2", color = colGreen(), display = display.data_window)
plot(sigTp3, "TP3", color = colGreen(), display = display.data_window)
alertcondition(buySig, NAME + ": buy", NAME + ': BUY {{ticker}} ({{interval}}). Entry {{plot("Entry")}}, stop {{plot("Stop")}}, TP1 {{plot("TP1")}}, TP2 {{plot("TP2")}}, TP3 {{plot("TP3")}}.')
alertcondition(sellSig, NAME + ": sell", NAME + ': SELL {{ticker}} ({{interval}}). Entry {{plot("Entry")}}, stop {{plot("Stop")}}, TP1 {{plot("TP1")}}, TP2 {{plot("TP2")}}, TP3 {{plot("TP3")}}.')
alertcondition(buySig or sellSig, NAME + ": any signal", NAME + ': signal on {{ticker}} ({{interval}}). Entry {{plot("Entry")}}, stop {{plot("Stop")}}, TP1 {{plot("TP1")}}, TP2 {{plot("TP2")}}, TP3 {{plot("TP3")}}.')
if barstate.islast and not tfOk
    notice(note, tfNote)
// ---- outputs:end ----
