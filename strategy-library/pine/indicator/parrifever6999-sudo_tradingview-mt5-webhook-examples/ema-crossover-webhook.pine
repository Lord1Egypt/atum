//@version=5
// Fast/slow EMA crossover that fires TradingView webhook alerts in the SignalForge JSON format.
// Add to chart, then create an alert (Setup tab -> Webhook -> URL https://api.signalforge-ai.com/wh/YOUR_TOKEN).
indicator("EMA Crossover Webhook (SignalForge)", overlay=true)

fastLen = input.int(9,   "Fast EMA")
slowLen = input.int(21,  "Slow EMA")
lotSize = input.float(0.1, "Lot size")
slPips  = input.float(50, "Stop loss (points)")
tpPips  = input.float(100, "Take profit (points)")

fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)

plot(fastEma, "Fast EMA", color=color.new(color.aqua, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))

buySignal  = ta.crossover(fastEma, slowEma)
sellSignal = ta.crossunder(fastEma, slowEma)

ticker = syminfo.ticker

if buySignal
    msg = str.format('{"action":"buy","symbol":"{0}","lot":{1},"sl":{2},"tp":{3}}',
      ticker, str.tostring(lotSize), str.tostring(slPips), str.tostring(tpPips))
    alert(msg, alert.freq_once_per_bar_close)

if sellSignal
    msg = str.format('{"action":"sell","symbol":"{0}","lot":{1},"sl":{2},"tp":{3}}',
      ticker, str.tostring(lotSize), str.tostring(slPips), str.tostring(tpPips))
    alert(msg, alert.freq_once_per_bar_close)
